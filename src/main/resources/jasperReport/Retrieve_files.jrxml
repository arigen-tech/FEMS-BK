	<queryString>
		<![CDATA[select 
	bm.address as branch_name,
    dm.name as department_name,
    cm.name as category_name,
    hd.document_name,
    hd.title,
    hd.subject,
    hd.category,
    hd.file_name,
    hd.version,
    hd.file_size,
    hd.action_by,
    hd.location,
    hd.job_id,
    hd.action_type
from document_activity_report hd
left join category_master cm on hd.category_id = cm.id
left join branch_master bm on hd.branch_id = bm.id
left join department_master dm on hd.department_id = dm.id
left join employee emp on hd.emp_id = emp.id
where 1=1
and hd.status = 'SUCCESS'
and hd.action_type = 'RETRIEVE'
and (hd.branch_id = $P{branch_id} or $P{branch_id} = 0)
and (hd.department_id = $P{department_id} or $P{department_id} = 0)
and (hd.emp_id = $P{employee_id} or $P{employee_id} = 0)
and (hd.category_id = $P{category_id} or $P{category_id} = 0)
and ($P{from_date} is null or hd.created_at >= $P{from_date})
and ($P{to_date} is null or hd.created_at <= $P{to_date})]]>
	</queryString>
